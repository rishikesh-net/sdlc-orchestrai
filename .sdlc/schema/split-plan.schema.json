{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirements split plan",
  "type": "object",
  "required": ["feature", "source", "slices"],
  "definitions": {
    "range": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
    "ranges": { "type": "array", "items": { "$ref": "#/definitions/range" } }
  },
  "properties": {
    "feature": { "type": "string" },
    "title": { "type": "string" },
    "source": { "type": "string" },
    "id_policy": { "enum": ["keep", "renumber"] },
    "id_regex": { "type": "string" },
    "slices": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["slug", "ranges"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string" },
          "prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$" },
          "summary": { "type": "string" },
          "priority": { "enum": ["Must", "Should", "Could", "Won't", ""] },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "ranges": { "$ref": "#/definitions/ranges" }
        }
      }
    },
    "cross_cutting": {
      "type": "object",
      "properties": {
        "overview": { "type": "object", "properties": { "ranges": { "$ref": "#/definitions/ranges" } } },
        "glossary": { "type": "object", "properties": { "ranges": { "$ref": "#/definitions/ranges" } } },
        "nfr": { "type": "object", "properties": { "prefix": { "type": "string" }, "ranges": { "$ref": "#/definitions/ranges" } } }
      },
      "additionalProperties": false
    },
    "skip": { "$ref": "#/definitions/ranges" },
    "skip_reason": { "type": "string" }
  }
}
