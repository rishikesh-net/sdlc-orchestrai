{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirements pack index (generated by req_index.py build)",
  "type": "object",
  "required": ["schema_version", "feature", "slices", "requirements"],
  "properties": {
    "schema_version": { "const": 1 },
    "feature": { "type": "string" },
    "id_policy": { "type": "string" },
    "id_regex": { "type": "string" },
    "slices": { "type": "array", "items": { "$ref": "#/definitions/file" } },
    "cross_cutting": { "type": "array", "items": { "$ref": "#/definitions/file" } },
    "requirements": {
      "type": "object",
      "additionalProperties": { "type": "object", "properties": { "file": { "type": "string" }, "title": { "type": "string" } } }
    },
    "totals": { "type": "object" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "file": {
      "type": "object",
      "required": ["slug", "file", "hash"],
      "properties": {
        "kind": { "enum": ["slice", "cross"] },
        "slug": { "type": "string" }, "file": { "type": "string" }, "title": { "type": "string" },
        "status": { "type": "string" }, "priority": { "type": "string" }, "prefix": { "type": "string" },
        "summary": { "type": "string" }, "depends_on": { "type": "array", "items": { "type": "string" } },
        "lines": { "type": "number" }, "approx_tokens": { "type": "number" }, "hash": { "type": "string" },
        "requirement_ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
