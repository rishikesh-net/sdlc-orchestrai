{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDLCOrchestrAI parallel slice manifest",
  "description": "Generated by `sdlc slices plan` into .sdlc/parallel/<feature>/<stage>/manifest.json. One work order per eligible slice.",
  "type": "object",
  "required": ["schema_version", "feature", "stage", "max_parallel", "slices", "skipped", "work_order_hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "feature": { "type": "string" },
    "stage": { "enum": ["design", "threat-model", "backlog"] },
    "generated_at": { "type": "string" },
    "max_parallel": { "type": "integer", "minimum": 1 },
    "prerequisites": {
      "type": "object",
      "properties": {
        "index": { "type": "string" },
        "overview": { "type": ["string", "null"] },
        "gate_source": { "type": ["string", "null"] }
      }
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "requirements_file", "requirement_ids", "outputs", "work_order"],
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "prefix": { "type": "string" },
          "priority": { "type": "string" },
          "status": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "requirements_file": { "type": "string" },
          "requirement_ids": { "type": "array", "items": { "type": "string" } },
          "design_file": { "type": ["string", "null"] },
          "slice_hash": { "type": "string" },
          "outputs": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "work_order": { "type": "string" },
          "notes_file": { "type": "string" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "reason"],
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "work_order_hash": { "type": "string" }
  }
}
