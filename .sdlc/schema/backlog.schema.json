{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDLCOrchestrAI backlog",
  "type": "object",
  "required": ["schema_version", "feature", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "feature": { "type": "string" },
    "source_docs": { "type": "array", "items": { "type": "string" } },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "type": { "enum": ["epic", "story", "task", "spike"] },
          "parent": { "type": ["string", "null"] },
          "title": { "type": "string", "maxLength": 200 },
          "user_story": { "type": "string" },
          "body_markdown": { "type": "string" },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "estimate": { "type": ["number", "null"] },
          "priority": { "enum": ["P0", "P1", "P2", "P3", null] },
          "labels": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "req_refs": { "type": "array", "items": { "type": "string" } },
          "design_ref": { "type": "string" },
          "external": {
            "type": "object",
            "properties": {
              "tracker": { "type": ["string", "null"] },
              "key": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
